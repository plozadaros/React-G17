# Copia este archivo como .env y ajusta los valores. El .env NO se sube a GitHub; este ejemplo SI.
# Vite solo deja pasar al navegador las variables que empiezan con VITE_ (se leen con import.meta.env).
# En produccion se configuran en Vercel: Settings > Environment Variables (y se redespliega).

# Direccion base de la API (DummyJSON: productos y login)
VITE_API_URL=https://dummyjson.com

# Nombre de la tienda: se muestra en el Header, el Footer y el titulo de la pestana
VITE_NOMBRE_TIENDA=TecCart
